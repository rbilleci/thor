# Temporal Open Source defaults. For Temporal Cloud, set the Cloud endpoint,
# namespace, TEMPORAL_TLS=true, and TEMPORAL_API_KEY.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=thor-delivery
TEMPORAL_TLS=false

# Choose a GitHub token for local development, or omit it and configure the
# three GitHub App variables below. Never commit the real .env file.
GITHUB_TOKEN=
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY_PATH=./secrets/github-app.pem
# GITHUB_APP_INSTALLATION_ID=
# Override only when targeting a GitHub Enterprise Server version that requires it.
GITHUB_API_VERSION=2026-03-10

# Checked-in desired Project schema, workflow profile, agent profiles, and skill selectors.
# Copy and customize one of config/templates/*.json. Runtime startup validates it against GitHub
# and compiles Project, field, and option node IDs automatically.
THOR_PROJECT_DECLARATION=./config/delivery-project.json

# GitHub Project polling synchronizer.
THOR_POLL_INTERVAL_MS=30000

# Repository checkout and generated worktree locations.
THOR_SOURCE_ROOT=./repositories
THOR_WORKTREE_ROOT=./.thor-worktrees
THOR_EXECUTION_ROOT=./.thor-executions
THOR_RESOURCE_ROOT=./resources

# Required only when collaboration.slack.enabled=true. Keep the gateway's public /slack/* ingress
# separate from its private /internal/control/* route.
# SLACK_BOT_TOKEN=
# SLACK_BOT_USER_ID=U012345
# SLACK_SIGNING_SECRET=
# THOR_SLACK_CONTROL_TOKEN=
# THOR_SLACK_GATEWAY_URL=http://localhost:8080
# THOR_SLACK_GATEWAY_PORT=8080

# Claude Agent SDK and Codex SDK read their normal provider authentication from
# the worker environment. Do not place these values in prompts or Project data.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
