# Temporal Open Source defaults. For Temporal Cloud, set the Cloud endpoint,
# namespace, TEMPORAL_TLS=true, and TEMPORAL_API_KEY.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=thor-delivery
TEMPORAL_TLS=false

# Choose a GitHub token for local development, or omit it and configure the
# three GitHub App variables below. Never commit the real .env file.
GITHUB_TOKEN=
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY_PATH=./secrets/github-app.pem
# GITHUB_APP_INSTALLATION_ID=
# Override only when targeting a GitHub Enterprise Server version that requires it.
GITHUB_API_VERSION=2026-03-10
GITHUB_PROJECT_ID=PVT_REPLACE_ME
GITHUB_STATUS_FIELD_ID=PVTSSF_REPLACE_ME
GITHUB_STATUS_OPTIONS_JSON={"backlog":"OPTION_BACKLOG","discovery":"OPTION_DISCOVERY","design_blueprint":"OPTION_DESIGN","awaiting_blueprint_approval":"OPTION_BLUEPRINT_APPROVAL","ready":"OPTION_READY","in_progress":"OPTION_IN_PROGRESS","ready_for_review":"OPTION_READY_FOR_REVIEW","in_review":"OPTION_IN_REVIEW","repairing":"OPTION_REPAIRING","re_review":"OPTION_RE_REVIEW","automated_review_passed":"OPTION_AUTOMATED_REVIEW_PASSED","awaiting_human_merge_review":"OPTION_HUMAN_MERGE_REVIEW","materializing_deferrals":"OPTION_MATERIALIZING_DEFERRALS","ready_to_merge":"OPTION_READY_TO_MERGE","merging":"OPTION_MERGING","done":"OPTION_DONE","blocked":"OPTION_BLOCKED","cancelled":"OPTION_CANCELLED"}
# Optional field/option routing for deferred issues. See docs/operations.md.
GITHUB_DEFERRED_FIELDS_JSON={}

# GitHub webhook delivery and fallback polling.
GITHUB_WEBHOOK_SECRET=replace-with-at-least-16-random-characters
THOR_SYNCHRONIZER_HOST=127.0.0.1
THOR_SYNCHRONIZER_PORT=8080
THOR_POLL_INTERVAL_MS=30000

# Repository checkout and generated worktree locations.
THOR_SOURCE_ROOT=./repositories
THOR_WORKTREE_ROOT=./.thor-worktrees
THOR_RESOURCE_ROOT=./resources
THOR_BASE_BRANCH=main

# Claude Agent SDK and Codex SDK read their normal provider authentication from
# the worker environment. Do not place these values in prompts or Project data.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
