{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/acme/thor/schema/thor-v1.schema.json",
  "title": "Thor v1 agent source schema",
  "$ref": "#/$defs/agentFrontmatter",
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "targetModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "effort"],
      "properties": {
        "model": { "type": "string", "minLength": 1 },
        "effort": { "type": "string", "enum": ["low", "medium", "high", "xhigh", "max"] }
      }
    },
    "claudeTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "effort"],
      "properties": {
        "model": { "type": "string", "minLength": 1 },
        "effort": { "type": "string", "enum": ["low", "medium", "high", "xhigh", "max"] },
        "maxTurns": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "background": { "type": "boolean" },
        "isolation": { "const": "worktree" }
      }
    },
    "agentFrontmatter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "requestedAccess", "targets"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "description": { "type": "string", "minLength": 1, "pattern": "^[^\\r\\n]+$" },
        "requestedAccess": { "type": "string", "enum": ["inherit", "read-only", "workspace-write"] },
        "template": { "$ref": "#/$defs/identifier" },
        "definitions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "targets": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "claude": { "$ref": "#/$defs/claudeTarget" },
            "codex": { "$ref": "#/$defs/targetModel" }
          }
        }
      }
    }
  }
}
