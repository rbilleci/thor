# Live tests mutate the selected private repository and GitHub Project. Copy this file to
# .env.live, verify the targets, and run npm run test:live:e2e. GITHUB_TOKEN is optional when the
# GitHub CLI is authenticated; the runner uses `gh auth token` without persisting it.
THOR_LIVE_REPOSITORY=owner/private-test-repository
THOR_LIVE_PROJECT_OWNER=owner
THOR_LIVE_PROJECT_NUMBER=1

# The Project must contain the Thor Status and policy fields documented in docs/operations.md.
THOR_LIVE_STATUS_FIELD=Thor Status
# Five seconds is suitable only for a small dedicated test Project. Increase this for larger
# Projects or an account with a constrained GraphQL/secondary-rate-limit budget.
THOR_LIVE_POLL_INTERVAL_MS=5000
THOR_LIVE_TIMEOUT_MS=300000

# success: clean successful remote fixtures and retain failed ones
# always: clean both successful and failed remote fixtures
# never: retain every remote fixture
# Retained fixtures can be removed with npm run test:live:cleanup -- <manifest-path>.
THOR_LIVE_CLEANUP=success
THOR_LIVE_RUN_ROOT=.thor-live-runs

# GITHUB_TOKEN=
